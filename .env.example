# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่องตัวเอง
#   cp .env.example .env
#
# .env อยู่ใน .gitignore แล้ว จะไม่ถูก commit ขึ้น git

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# ค่าปริยายนี้ตรงกับ docker-compose.yml -- ถ้ารัน docker compose up -d
# ก็ใช้ค่านี้ได้เลยโดยไม่ต้องแก้อะไร
#
# ใช้ port 5433 (ไม่ใช่ 5432 ตามมาตรฐาน) เพื่อไม่ให้ชนกับ Postgres
# ตัวอื่นที่อาจติดตั้งไว้ในเครื่องอยู่แล้ว
DATABASE_URL="postgresql://duritrack:duritrack_dev_password@localhost:5433/duritrack"

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# ใช้เซ็น token ที่เก็บใน httpOnly cookie
#
# ค่านี้เป็นความลับ ใครรู้ค่านี้จะปลอม token เป็นแอดมินได้
# ก่อนขึ้น production ต้องเปลี่ยนเป็นค่าสุ่มยาว ๆ เช่น
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="dev_only_secret_change_me_before_production"

# ---------------------------------------------------------------------------
# ตัวเลือกเพิ่มเติม
# ---------------------------------------------------------------------------
# พอร์ตของ Express API (ถ้าไม่ตั้ง จะใช้ 3001)
# ถ้าเปลี่ยนค่านี้ vite proxy ใน vite.config.ts จะตามไปเอง
# API_PORT=3001

# ---------------------------------------------------------------------------
# GEMINI_API_KEY: จำเป็นสำหรับการเรียก Gemini AI API
# AI Studio ใส่ค่านี้ให้อัตโนมัติตอนรันจาก Secrets panel
# ---------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ---------------------------------------------------------------------------
# APP_URL: URL ที่แอปนี้ถูกโฮสต์อยู่
# AI Studio ใส่ค่านี้ให้อัตโนมัติเป็น Cloud Run service URL
# ---------------------------------------------------------------------------
APP_URL="MY_APP_URL"

# กุญแจสำหรับให้ระบบของสวนส่งประวัติการดูแลเข้ามา (ส่งใน header x-api-key)
# สร้างค่าใหม่ด้วย npm run gen:secret
CARE_LOG_API_KEY="change_me"

# ---------------------------------------------------------------------------
# ความปลอดภัยตอนขึ้น production
# ---------------------------------------------------------------------------
# COOKIE_SECURE: ส่ง auth cookie เฉพาะบน https
# ปล่อยว่างไว้ก็ได้ ระบบจะเปิดเองเมื่อ NODE_ENV=production
# ตั้ง true/false เพื่อบังคับแยกจาก NODE_ENV
# COOKIE_SECURE=true

# TRUST_PROXY: ตั้งเมื่อ API อยู่หลัง reverse proxy หรือ load balancer
# ตัวจำกัดอัตราการล็อกอินนับตาม req.ip ถ้าไม่ตั้งค่านี้ ทุก request
# จะดูเหมือนมาจาก IP ของ proxy ตัวเดียว ทำให้ผู้ใช้ทุกคนใช้โควตาร่วมกัน
#
# ห้ามตั้งถ้าไม่มี proxy จริง เพราะ express จะเชื่อ header X-Forwarded-For
# ที่ client ปลอมเองได้ ทำให้เลี่ยงตัวจำกัดอัตราได้ทันที
#
# ใส่จำนวน hop เช่น 1 หรือใส่ชื่อ preset ของ express เช่น loopback
# TRUST_PROXY=1

# RATE_LIMIT_ALLOW_LOOPBACK: ยกเว้น rate limit ให้ request จากเครื่องเดียวกัน
# เปิดไว้ตอนพัฒนาเท่านั้น เพราะ smoke test สมัครสมาชิก 3 คนต่อรอบ
# รันซ้ำไม่กี่รอบก็ชนเพดาน 20 ครั้ง/ชั่วโมง
#
# ห้ามเปิดบน production ถ้า API อยู่หลัง reverse proxy บนเครื่องเดียวกัน
# req.ip จะเป็น 127.0.0.1 ของ proxy ทุก request แปลว่ายกเว้นให้ทั้งโลก
# ตัวโค้ดกันไว้อีกชั้นแล้ว ถ้า NODE_ENV=production จะไม่ยกเว้นให้ไม่ว่าตั้งค่านี้ไว้ยังไง
RATE_LIMIT_ALLOW_LOOPBACK=true
