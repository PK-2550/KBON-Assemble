rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Accounts collection for username authentication
    match /accounts/{usernameId} {
      allow read, write: if isValidId(usernameId);
    }

    // Users collection: user profiles
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Farms collection: readable by everyone, writable
    match /farms/{farmId} {
      allow read: if true;
      allow create, update: if isValidId(farmId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 200;
      allow delete: if false;
    }

    // Farm registration & upgrade requests
    match /farm_requests/{requestId} {
      allow read, write: if isValidId(requestId);
    }

    // Trees collection: readable by everyone, writable
    match /trees/{treeId} {
      allow read: if true;
      allow create, update: if isValidId(treeId) &&
        request.resource.data.code is string &&
        request.resource.data.code.size() <= 50;
      allow delete: if false;
    }

    // Reviews collection: readable by everyone, writable
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) &&
        request.resource.data.authorName is string &&
        request.resource.data.authorName.size() <= 100 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() <= 2000;
      allow update, delete: if false;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
